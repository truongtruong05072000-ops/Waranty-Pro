# ===================================================================
# VINFAST CARON THỚI AN (N54511) - REALTIME SYNC SERVER CONFIG
# ===================================================================

# Cổng Web Server và WebSocket
PORT=8787

# Thông tin Chi nhánh
DEALER_CODE=N54511
BRANCH_ID=2

# 1. HỆ THỐNG ATT-SERVICEOS (Đăng nhập tự động & Auto-refresh Cookie)
SERVICEOS_BASE_URL=https://att-serviceos.anthinhtech.vn
SERVICEOS_USERNAME=truongtnn
SERVICEOS_PASSWORD=
# Chu kỳ quét ServiceOS (mili-giây, mặc định 4000ms = 4 giây)
SERVICEOS_POLL_INTERVAL=4000

# 2. HỆ THỐNG VINFAST DEALER PORTAL (Auto-refresh JWT Token 12 phút/lần)
DEALER_PORTAL_BASE_URL=https://dealer-portal-api.vinfast.com
DEALER_PORTAL_ACCESS_TOKEN=
DEALER_PORTAL_REFRESH_TOKEN=
# Chu kỳ quét Stream B (lệnh mới/vừa xuất xưởng - mặc định 5000ms)
DEALER_PORTAL_STREAM_B_INTERVAL=5000
# Chu kỳ quét Stream A (toán bộ lệnh đang mở - mặc định 35000ms)
DEALER_PORTAL_STREAM_A_INTERVAL=35000
